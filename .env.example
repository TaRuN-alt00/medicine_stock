# Medicine Stock Finder - Environment Variables Example
# Do not commit real keys to Git repository

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Feature Flags
NEXT_PUBLIC_FEATURE_HOME_DELIVERY=false
NEXT_PUBLIC_FEATURE_PHOTO_SEARCH=true

# Firebase Client Configuration (Optional in local development/emulator mode)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=medicine-stock-finder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=medicine-stock-finder
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=medicine-stock-finder.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Firebase Emulator (Set to true to connect client to local emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
